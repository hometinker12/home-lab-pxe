# Copy to .env and fill in local values. Never commit .env.

# Web console
PXE_HTTP_BIND=0.0.0.0
PXE_HTTP_PORT=8080
# HTTPS console (self-signed cert is created on first start; replace it under Settings).
PXE_HTTPS_PORT=8443
PXE_SSL_DIR=/var/lib/pxe/ssl
SECRET_KEY=change-me-to-a-long-random-string

# Bootstrap the first console user when the database is empty.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin-password

# Fernet key for Linux root and Windows local Administrator username/password at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-fernet-key

# Test-only. Never set in production.
# PXE_ALLOW_INSECURE_DEFAULTS=1

# Network boot. Proxy DHCP is the default so an existing home-lab DHCP server can stay authoritative.
PXE_DHCP_MODE=proxy
PXE_BIND_INTERFACE=eth0
PXE_TFTP_ROOT=/var/lib/pxe/tftp
PXE_IMAGE_ROOT=/var/lib/pxe/images
PXE_PUBLIC_URL=http://192.168.1.10:8080
# Keep PXE_PUBLIC_URL as http:// so iPXE and guest-init do not need the console TLS certificate.
# LAN IPv4 of this computer (not 127.0.0.1, not a Docker 172.x). Shown in Settings → PXE.
PXE_HOST_LAN_IPV4=192.168.1.10
PXE_ENABLE_DHCP=1
PXE_ENABLE_TFTP=1
PXE_DHCP_OPTIONAL=1
PXE_DATA_DIR=/var/lib/pxe/data
# Max size for a single kernel/initrd/WIM/ISO/TFTP upload in the console (bytes).
PXE_MAX_UPLOAD_BYTES=8589934592
# Max size of an editable cloud-init / unattend seed file (bytes).
PXE_MAX_SEED_BYTES=1048576
# Max uncompressed Windows media or Ubuntu casper+dists+pool extract (bytes).
PXE_MAX_EXTRACT_BYTES=21474836480
# Background ISO extract timeout (seconds). 0 waits until the worker finishes.
# PXE_EXTRACT_TIMEOUT_SECONDS=3600

# Optional 7-Zip binary name or path. Default: first of 7z, 7zz, 7za on PATH.
# PXE_7Z_BIN=7z

# Read-only Windows Setup media share (authenticated). Required for Windows PXE
# installs on Linux host networking. Do not publish host TCP 445 from Docker Desktop.
# PXE_SMB_HOST defaults to the host in PXE_PUBLIC_URL.
PXE_SMB_USER=pxemedia
# Optional first-boot default (20-128 URL-safe characters: A-Z a-z 0-9 . _ - ~).
# After first start, Settings → Windows installation media (SMB) → Rotate password
# is the source of truth. Never commit a real password.
PXE_SMB_PASSWORD=replace-with-20-plus-url-safe-chars

# Read-only Ubuntu casper NFS (userspace nfs-ganesha). PXE_NFS_HOST defaults to
# PXE_SMB_HOST. PXE_NFS_EXPORT is the parent of per-generation Paths
# (nfsroot becomes host:PXE_NFS_EXPORT/{id}/{rev} after each ISO extract).
# Ubuntu casper nfsmount always uses rpcbind on TCP/UDP 111 (it ignores mountport=).
# PXE_NFS_HOST=192.168.1.10
# PXE_NFS_EXPORT=/var/lib/pxe/images/nfs

# Optional: become the LAN DHCP server instead of proxyDHCP.
# PXE_DHCP_MODE=authoritative
# PXE_DHCP_RANGE=192.168.1.200,192.168.1.250,12h
# PXE_DHCP_ROUTER=192.168.1.1
# PXE_DHCP_DNS=192.168.1.1

# SQLite inventory (path inside the container / data volume)
PXE_DATABASE_URL=sqlite:////var/lib/pxe/data/pxe.db

# First-boot default for Settings → Machines imaging timeout (minutes).
# After first start, change it in the console. 0 disables the timer.
# PXE_IMAGING_TIMEOUT_MINUTES=15

# First-boot default IANA timezone for new and discovered machines.
# After first start, change it under Settings → Machines.
# PXE_DEFAULT_TIMEZONE=UTC

# First-boot defaults for Boot menu iPXE timeouts (seconds). After first start, change them under Boot menu.
# Unknown and disabled hosts continue to disk after this delay. 0 is immediate.
# PXE_UNKNOWN_BOOT_TIMEOUT_SECONDS=5
# Named/ready hosts: countdown on the continue-to-disk menu item. 0 waits for a key.
# PXE_MENU_TIMEOUT_SECONDS=10
