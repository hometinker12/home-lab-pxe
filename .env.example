# Copy to .env and fill in local values. Never commit .env.

# Web console
PXE_HTTP_BIND=0.0.0.0
PXE_HTTP_PORT=8080
# HTTPS console (self-signed cert is created on first start; replace it under Settings).
PXE_HTTPS_PORT=8443
PXE_SSL_DIR=/var/lib/pxe/ssl
SECRET_KEY=change-me-to-a-long-random-string

# Bootstrap the first console user when the database is empty.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin-password

# Fernet key for Linux root and Windows local Administrator username/password at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-fernet-key

# Test-only. Never set in production.
# PXE_ALLOW_INSECURE_DEFAULTS=1

# Network boot. Proxy DHCP is the default so an existing home-lab DHCP server can stay authoritative.
PXE_DHCP_MODE=proxy
PXE_BIND_INTERFACE=eth0
PXE_TFTP_ROOT=/var/lib/pxe/tftp
PXE_IMAGE_ROOT=/var/lib/pxe/images
PXE_PUBLIC_URL=http://192.168.1.10:8080
# Keep PXE_PUBLIC_URL as http:// so iPXE and guest-init do not need the console TLS certificate.
# LAN IPv4 of this computer (not 127.0.0.1, not a Docker 172.x). Shown in Settings.
# Detect and pass into Compose: python scripts/host_lan_ipv4.py --write
# PXE_HOST_LAN_IPV4=192.168.1.10
PXE_ENABLE_DHCP=1
PXE_ENABLE_TFTP=1
PXE_DHCP_OPTIONAL=1
PXE_DATA_DIR=/var/lib/pxe/data
# Max size for a single kernel/initrd/WIM/ISO upload in the console (bytes).
PXE_MAX_UPLOAD_BYTES=8589934592

# Optional: become the LAN DHCP server instead of proxyDHCP.
# PXE_DHCP_MODE=authoritative
# PXE_DHCP_RANGE=192.168.1.200,192.168.1.250,12h
# PXE_DHCP_ROUTER=192.168.1.1
# PXE_DHCP_DNS=192.168.1.1

# SQLite inventory (path inside the container / data volume)
PXE_DATABASE_URL=sqlite:////var/lib/pxe/data/pxe.db
