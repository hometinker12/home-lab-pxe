#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  refresh-installer:
    update: false
  source:
    id: ubuntu-server-minimal
    search_drivers: false
  network:
    version: 2
    ethernets:
      zz-all-en:
        match:
          name: en*
        dhcp4: true
      zz-all-eth:
        match:
          name: eth*
        dhcp4: true
  proxy: null
  apt:
    preserve_sources_list: false
    geoip: false
    fallback: offline-install
    mirror-selection:
      primary:
        - uri: http://archive.ubuntu.com/ubuntu
          arches: [amd64, i386]
        - uri: http://ports.ubuntu.com/ubuntu-ports
          arches: [arm64, armhf, ppc64el, riscv64, s390x]
  storage:
    layout:
      name: lvm
  timezone: {{timezone}}
  ssh:
    install-server: true
    allow-pw: true
    authorized-keys: []
  user-data:
    hostname: {{hostname}}
    manage_etc_hosts: true
    timezone: {{timezone}}
    disable_root: false
    ssh_pwauth: true
    chpasswd:
      expire: false
      users:
        - name: {{username}}
          password: {{password_hash}}
          type: hash
  shutdown: reboot
  updates: security
  early-commands:
    - "rm -f /etc/apt/sources.list.d/cdrom.list /etc/apt/sources.list.d/cdrom-sources.list"
    - "sed -i.bak -e '/cdrom/d' -e '\\#file:/cdrom#d' /etc/apt/sources.list || true"
  late-commands:
    - [wget, -q, --post-data=, -O, /dev/null, {{phone_home_url}}]
